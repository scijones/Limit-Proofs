import AsymptoticBB.Grammars.Union
import Mathlib

/-!
# Finite languages as MCFGs

A finite language is generated by an ordinary context-free grammar (hence by a
one-dimensional MCFG).  This elementary construction is useful for genuinely
per-instance finite languages; it does not provide a uniform grammar over an
unbounded family of alphabets or instances.
-/

set_option autoImplicit false

universe u

namespace MCFG

/-- The one-production MCFG generating a prescribed word. -/
noncomputable def singletonWord {Sym : Type u} (w : List Sym) : MCFG.{u, 0} Sym where
  N := Unit
  ar := fun _ => 1
  ar_pos := fun _ => Nat.one_pos
  S := ()
  start_arity := rfl
  productions :=
    [{ lhs := ()
       rhs := []
       rhs_vars := []
       lhs_strings := [w.map Sum.inl]
       lhs_arity := rfl
       rhs_len := rfl
       rhs_arities := fun i => Fin.elim0 i
       rhs_vars_nodup := by simp
       lhs_indices_bounded := by simp
       lhs_vars_nodup := by
         induction w with
         | nil => simp
         | cons a w ih => simp [ih] }]

/-- The prescribed word is generated by its singleton grammar. -/
theorem singletonWord_generates {Sym : Type u} (w : List Sym) :
    (singletonWord w).Generates (singletonWord w).S [w] := by
  sorry

/-- Every word generated by the singleton grammar is the prescribed word. -/
theorem singletonWord_generates_only {Sym : Type u} (w x : List Sym)
    (h : (singletonWord w).Generates (singletonWord w).S [x]) : x = w := by
  sorry

/-- The singleton grammar has dimension one. -/
theorem singletonWord_dimension_le {Sym : Type u} (w : List Sym) :
    (singletonWord w).dimension ≤ 1 := by
  sorry

/-- The singleton grammar's language is exactly the singleton language. -/
theorem singletonWord_language {Sym : Type u} (w : List Sym) :
    (singletonWord w).Language = ({w} : Set (List Sym)) := by
  sorry

end MCFG

/-- The singleton language containing one word is generated by a 1-MCFG. -/
theorem singleton_word_isMCFL {Sym : Type u} (w : List Sym) :
    IsMCFL.{u, 0} ({w} : Set (List Sym)) 1 := by
  exact ⟨MCFG.singletonWord w, MCFG.singletonWord_dimension_le w,
    MCFG.singletonWord_language w⟩

/-- Every finite language is generated by a 1-MCFG. -/
theorem finite_language_isMCFL {Sym : Type u} (L : Set (List Sym))
    (hL : L.Finite) : IsMCFL.{u, 0} L 1 := by
  sorry

/-- A finite language belongs to every positive MCFG tier. -/
theorem finite_language_isMCFL_of_pos {Sym : Type u} (L : Set (List Sym))
    (hL : L.Finite) {d : ℕ} (hd : 1 ≤ d) : IsMCFL.{u, 0} L d := by
  sorry
